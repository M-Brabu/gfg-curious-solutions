class Solution {
    public int minMovesToSeat(int[] seats, int[] students) {
        Arrays.sort(seats);
        Arrays.sort(students);
        int n = seats.length;
        int sum = 0;
        for(int i=0 ; i<n; i++){
          sum = sum + Math.abs(seats[i]-students[i]);
        }
     return sum;
    }
}
t.c : O(n log n) , s.c : O(log n)
