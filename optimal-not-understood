4)last word length : e.g hello world -> world 5 
class Solution {
    public int lengthOfLastWord(String s) {
        int i = s.length() - 1;
        // Skip trailing spaces
        while (i >= 0 && s.charAt(i) == ' ') {
           i--;
        }
        int length = 0;
        // Count characters of the last word
        while (i >= 0 && s.charAt(i) != ' ') {
            length++;
            i--;
        }
        return length;
    }
}
t.c : O(n) , s.c : O(1)
