class Solution {
    public int GCD(int n1, int n2) {
         int min = n1<=n2 ? n1 : n2;
         int gcd=1;
         for(int i=2;i<=min;i++){
            if(n1%i==0 && n2%i==0){
                 gcd = i;
            }
         }
         return gcd;
    }
}
optimal use euclidean algorithm : gcd(a,b) = (b,a%b):
class Solution {
    public int GCD(int n1, int n2) {
        while(n2!=0){
            int rem =  n1 % n2;
            n1=n2;
            n2=rem;
        }
        return n1;
    }
}       brute           euclidean
